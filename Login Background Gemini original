<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ReviewShield AI — Phase 3</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Arial,sans-serif;background:#06101d;color:#172033;min-height:100vh;overflow-x:hidden}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.side{width:245px;background:#fff;border-right:1px solid #e6e9ef;padding:22px 15px;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;height:100vh}
.brand{font-weight:800;font-size:17px;padding:0 10px 28px;display:flex;align-items:center;gap:9px}
.logo{width:34px;height:34px;border-radius:9px;background:#172033;color:white;display:grid;place-items:center}
.nav button{width:100%;border:0;background:none;text-align:left;padding:12px;border-radius:9px;color:#687386;cursor:pointer;font-weight:650;margin-bottom:2px}
.nav button.active{background:#eef1f8;color:#172033}
.bottom{margin-top:auto}
.plan{padding:14px;border:1px solid #e7eaf0;border-radius:12px;background:#fafbfc;margin-bottom:12px}
.plan small{display:block;color:#8b94a3}
.plan button,.primary{background:#172033;color:#fff;border:0;border-radius:8px;padding:10px 13px;font-weight:700;cursor:pointer}
.plan button{width:100%;margin-top:9px}
.user{display:flex;gap:9px;align-items:center;padding:6px}
.avatar{width:33px;height:33px;border-radius:50%;background:#dfe4ee;display:grid;place-items:center;font-weight:800;flex:0 0 auto}
.main{margin-left:245px;width:calc(100% - 245px)}
.top{height:68px;background:#fff;border-bottom:1px solid #e6e9ef;padding:0 32px;display:flex;justify-content:space-between;align-items:center}
.business{font-size:13px}
.business strong{margin-left:8px}
.topright{display:flex;gap:9px;align-items:center}
.ghost{border:1px solid #e3e7ee;background:#fff;border-radius:8px;padding:8px 11px;cursor:pointer}
.page{padding:30px;max-width:1400px;margin:auto}
.head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}
.head h1{margin:0 0 5px;font-size:26px}
.muted{color:#7d8798}
.eyebrow{font-size:10px;letter-spacing:.12em;font-weight:800;color:#9aa3b1}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.card{background:#fff;border:1px solid #e7eaf0;border-radius:12px}
.stat{padding:18px}
.stat small{color:#8a94a5}
.stat strong{display:block;font-size:26px;margin:7px 0}
.green{color:#267c55}
.amber{color:#9d691a}
.danger{color:#b33e3e}
.section{margin-top:18px;padding:20px}
.section h2{font-size:16px;margin:0 0 4px}
.review-list{display:grid;gap:10px;margin-top:15px}
.review{border:1px solid #e8ebf0;border-radius:10px;padding:15px;display:grid;grid-template-columns:1fr auto;gap:12px}
.review p{margin:7px 0;color:#505c70;font-size:13px;line-height:1.5}
.review small{color:#9aa3b1}
.badge{display:inline-block;padding:5px 8px;border-radius:6px;font-size:10px;font-weight:800}
.flag{background:#fff0df;color:#9b651a}
.safe{background:#e9f6ef;color:#287b55}
.danger-badge{background:#fbe8e8;color:#b33e3e}
.actions{display:flex;gap:7px;align-items:center}
.hidden{display:none!important}
.form{display:grid;gap:12px;max-width:760px}
.form textarea,.form input,.form select,.field input,.field select,.field textarea{width:100%;border:1px solid #dfe4ec;border-radius:9px;padding:12px;background:#fff}
.form textarea{min-height:150px;resize:vertical}
.result{padding:15px;border-radius:10px;background:#f7f8fb;border:1px solid #e6e9ef}
.result strong{display:block;margin-bottom:6px}
.case{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:14px 0;border-top:1px solid #edf0f4}
.case:first-child{border-top:0}
.status{padding:5px 8px;border-radius:6px;background:#eef1f8;font-size:10px;font-weight:800}
.empty{padding:45px;text-align:center;color:#8b94a3}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.filter-btn{border:1px solid #e3e7ee;background:#fff;border-radius:8px;padding:8px 11px;color:#687386;font-size:12px;font-weight:700}
.filter-btn.active{background:#172033;color:#fff;border-color:#172033}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.field{display:grid;gap:7px}
.field label{font-size:12px;font-weight:700}
.profile-avatar{width:74px;height:74px;border-radius:50%;background:#dfe4ee;display:grid;place-items:center;font-size:26px;font-weight:800;margin-bottom:12px}
.notification{padding:12px 0;border-top:1px solid #edf0f4;font-size:13px}
.notification:first-child{border-top:0}
.chart-wrap{position:relative;height:300px}

/* Advanced Glassmorphism Login Background & Auth Box Styles */
.auth-wrap{
    position:fixed;
    inset:0;
    background:#070d19;
    display:grid;
    place-items:center;
    z-index:9999;
    overflow:hidden;
}
.glow-sphere-1 {
    position: absolute;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(235, 67, 53, 0.22) 0%, rgba(0, 0, 0, 0) 70%);
    top: -60px;
    left: -60px;
    border-radius: 50%;
    filter: blur(60px);
    animation: float 8s ease-in-out infinite alternate;
    pointer-events: none;
}
.glow-sphere-2 {
    position: absolute;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(66, 133, 244, 0.25) 0%, rgba(0, 0, 0, 0) 70%);
    bottom: -90px;
    right: -90px;
    border-radius: 50%;
    filter: blur(70px);
    animation: float 10s ease-in-out infinite alternate-reverse;
    pointer-events: none;
}
.bg-pattern {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 0);
    background-size: 28px 28px;
    z-index: 1;
    opacity: 0.5;
    pointer-events: none;
}
.auth-box{
    position: relative;
    z-index: 10;
    width: min(440px, 92vw);
    background: rgba(13, 26, 43, 0.75);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    padding: 34px 28px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(235, 67, 53, 0.08);
}
.shield-header-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    background: linear-gradient(135deg, rgba(235, 67, 53, 0.2), rgba(66, 133, 244, 0.2));
    border: 1px solid rgba(235, 67, 53, 0.35);
    border-radius: 14px;
    margin: 0 auto 12px auto;
    box-shadow: 0 0 15px rgba(235, 67, 53, 0.25);
}
.shield-header-badge svg {
    width: 28px;
    height: 28px;
    fill: #ea4335;
}
.status-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 11px;
    color: #f87171;
    margin: 0 auto 18px auto;
    width: fit-content;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.status-dot {
    width: 6px;
    height: 6px;
    background-color: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse 1.5s infinite;
}
.auth-box h1{margin:0 0 6px;font-size:22px;text-align:center;color:#fff;}
.auth-box p{margin:0 0 20px;color:#8fa2ba;font-size:13px;text-align:center;}
.auth-box input{width:100%;padding:12px;border:1px solid #29415e;border-radius:9px;margin-bottom:10px;background:#0a1727;color:#edf4ff;}
.auth-box .primary{width:100%;margin-top:4px}
.auth-switch{text-align:center;margin-top:15px;font-size:13px;color:#8fa2ba}
.auth-switch button{border:0;background:none;color:#76a7ff;font-weight:800;cursor:pointer}
.auth-msg{font-size:12px;margin-top:12px;line-height:1.5;min-height:18px;text-align:center}
.top-email{font-size:12px;color:#7d8798}

@keyframes float {
    0% { transform: translateY(0px) scale(1); }
    100% { transform: translateY(-25px) scale(1.04); }
}
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
}

@media(max-width:900px){
.side{width:72px}
.brand span:last-child,.nav button span,.plan,.user div:last-child{display:none}
.nav button{text-align:center}
.main{margin-left:72px;width:calc(100% - 72px)}
.stats{grid-template-columns:repeat(2,1fr)}
.grid2{grid-template-columns:1fr}
}
@media(max-width:600px){
.page{padding:18px}
.stats{grid-template-columns:1fr}
.head{gap:12px;flex-direction:column}
.review{grid-template-columns:1fr}
.case{grid-template-columns:1fr}
.top{padding:0 16px}
.business{display:none}
.topright{margin-left:auto}
.top-email{display:none}
}
</style>

<style id="professional-theme">
:root{
  --rs-bg:#07111f;
  --rs-panel:#0d1a2b;
  --rs-panel-2:#101f33;
  --rs-border:#1d3048;
  --rs-text:#edf4ff;
  --rs-muted:#8fa2ba;
  --rs-accent:#4f8cff;
  --rs-accent-2:#6ea2ff;
  --rs-success:#36d399;
  --rs-warning:#f6bd60;
  --rs-danger:#ff6b78;
}
body{background:linear-gradient(135deg,#06101d 0%,#091728 48%,#07111f 100%);color:var(--rs-text)}
.side,.top,.card{
  background:rgba(13,26,43,.96);
  border-color:var(--rs-border);
  color:var(--rs-text);
}
.side{box-shadow:14px 0 35px rgba(0,0,0,.16)}
.logo{background:linear-gradient(135deg,var(--rs-accent),#7b61ff);box-shadow:0 7px 20px rgba(79,140,255,.28)}
.brand{color:#fff}
.nav button{color:#91a3ba;transition:.2s ease}
.nav button:hover{background:#14263d;color:#fff;transform:translateX(2px)}
.nav button.active{background:linear-gradient(90deg,rgba(79,140,255,.22),rgba(79,140,255,.08));color:#fff;border:1px solid rgba(79,140,255,.22)}
.plan{background:linear-gradient(145deg,#11233a,#0b1829);border-color:#223852}
.plan small,.muted,.stat small,.review small,.top-email{color:var(--rs-muted)}
.plan button,.primary{
  background:linear-gradient(135deg,#4f8cff,#356fe0);
  color:#fff;
  border:1px solid rgba(255,255,255,.08);
  box-shadow:0 8px 22px rgba(30,94,210,.24);
  transition:.2s ease;
}
.plan button:hover,.primary:hover{transform:translateY(-1px);filter:brightness(1.08);box-shadow:0 11px 28px rgba(30,94,210,.32)}
.ghost,.filter-btn{
  background:#101f33;
  color:#b9c8dc;
  border-color:#263c57;
  transition:.2s ease;
}
.ghost:hover,.filter-btn:hover{background:#172a43;color:#fff;border-color:#3b5d85}
.filter-btn.active{background:#4f8cff;color:#fff;border-color:#4f8cff;box-shadow:0 6px 18px rgba(79,140,255,.22)}
.stat,.section{box-shadow:0 12px 32px rgba(0,0,0,.12)}
.stat strong{color:#fff}
.review{background:#0c192a;border-color:#20354f;transition:.2s ease}
.review:hover{border-color:#365b86;transform:translateY(-1px);box-shadow:0 9px 24px rgba(0,0,0,.14)}
.review p{color:#b8c6d8}
.result{background:#0b1829;border-color:#223852;color:#dce8f8}
.form textarea,.form input,.form select,.field input,.field select,.field textarea{
  background:#0a1727;color:#edf4ff;border-color:#29415e;
}
.form textarea:focus,.form input:focus,.form select:focus,.field input:focus,.field select:focus,.field textarea:focus,.auth-box input:focus{
  outline:none;border-color:#4f8cff;box-shadow:0 0 0 3px rgba(79,140,255,.12)
}
.form textarea::placeholder,.form input::placeholder,.field input::placeholder,.field textarea::placeholder,.auth-box input::placeholder{color:#687d97}
.case{border-color:#20354f}
.status{background:#162a43;color:#b9c9dd}
.safe{background:rgba(54,211,153,.13);color:#55e0aa}
.flag{background:rgba(246,189,96,.13);color:#f6c979}
.danger-badge{background:rgba(255,107,120,.13);color:#ff8a95}
.eyebrow{color:#6ea2ff}
.green{color:var(--rs-success)}
.amber{color:var(--rs-warning)}
.danger{color:var(--rs-danger)}
.empty{color:#7489a3}
.chart-wrap canvas{filter:saturate(1.05)}
.notification{border-color:#20354f}
.notification:hover{background:#0f2035}
.user{border-radius:10px}
.avatar,.profile-avatar{background:linear-gradient(135deg,#213a5b,#172a43);color:#fff;border:1px solid #315171}
</style>

<style id="notification-theme">
.bell-wrap{position:relative}
.bell-button{position:relative;width:40px;height:40px;padding:0;display:grid;place-items:center;font-size:17px}
.bell-icon{display:block;transform:rotate(180deg);font-weight:900}
.notification-badge{
 position:absolute;right:-3px;top:-4px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;
 display:grid;place-items:center;background:#ff4d67;color:#fff;font-size:10px;font-weight:900;
 border:2px solid #0d1a2b;box-shadow:0 4px 12px rgba(255,77,103,.35)
}
.notification-panel{
 position:absolute;right:0;top:48px;width:340px;max-width:calc(100vw - 28px);
 background:#0d1a2b;border:1px solid #29415e;border-radius:14px;
 box-shadow:0 24px 60px rgba(0,0,0,.42);z-index:5000;overflow:hidden
}
.notification-head{display:flex;justify-content:space-between;align-items:center;padding:14px 15px;border-bottom:1px solid #20354f;color:#fff}
.notification-clear{border:0;background:none;color:#75a7ff;font-size:11px;font-weight:800;cursor:pointer}
#notificationItems{max-height:330px;overflow:auto}
.notification-item{padding:13px 15px;border-bottom:1px solid #1b2e45;cursor:pointer}
.notification-item:hover{background:#10233a}
.notification-item b{display:block;font-size:12px;color:#eef4ff;margin-bottom:4px}
.notification-item small{color:#8297b0;font-size:10px}
.notification-dot{display:inline-block;width:6px;height:6px;background:#4f8cff;border-radius:50%;margin-right:6px;vertical-align:middle}
.notification-foot{padding:10px 15px;text-align:center}
.notification-foot button{border:0;background:none;color:#75a7ff;font-weight:800;font-size:11px;cursor:pointer}
@media(max-width:600px){.notification-panel{right:-48px;width:320px}}
</style>

</head>
<body>

<div id="authWrap" class="auth-wrap">
  <!-- Glowing Ambient Spheres & Pattern -->
  <div class="glow-sphere-1"></div>
  <div class="glow-sphere-2"></div>
  <div class="bg-pattern"></div>

  <div class="auth-box">
    <div class="shield-header-badge">
      <svg viewBox="0 0 24 24">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
    </div>
    
    <div class="status-pill">
      <span class="status-dot"></span>
      Fake Review Shield Active
    </div>

    <h1 id="authTitle">Welcome to ReviewShield AI</h1>
    <p id="authSubtitle">Sign in to access your private review dashboard.</p>
    
    <div id="signupNameWrap" class="hidden">
      <input id="authName" type="text" placeholder="Your name" autocomplete="name">
    </div>
    <input id="authEmail" type="email" placeholder="Email address" autocomplete="email">
    <input id="authPassword" type="password" placeholder="Password" autocomplete="current-password">
    <button id="authButton" class="primary" type="button" onclick="handleAuth()">Sign in</button>
    
    <div id="authMsg" class="auth-msg"></div>
    
    <div class="auth-switch">
      <span id="authSwitchText">Don't have an account?</span>
      <button type="button" onclick="toggleAuthMode()">Create account</button>
    </div>
  </div>
</div>

<div id="appShell" class="app hidden">
<aside class="side">
<div class="brand"><span class="logo">R</span><span>ReviewShield AI</span></div>
<div class="nav">
<button class="active" onclick="show('dashboard',this)">⌂ &nbsp; Dashboard</button>
<button onclick="show('reviews',this)">★ &nbsp; Reviews</button>
<button onclick="show('analyzer',this)">⚑ &nbsp; AI Analyzer</button>
<button onclick="show('cases',this)">▣ &nbsp; Cases</button>
<button onclick="show('responses',this)">◈ &nbsp; AI Responses</button>
<button onclick="show('profile',this)">◎ &nbsp; Profile</button>
<button onclick="show('activity',this)">◌ &nbsp; Activity</button>
<button onclick="show('settings',this)">⚙ &nbsp; Settings</button>
</div>
<div class="bottom">
<div class="plan"><small>Current plan</small><b>Starter</b><button type="button" onclick="showToast('Upgrade options will be available in the next billing stage.')">Upgrade</button></div>
<div class="user"><div id="sideAvatar" class="avatar">U</div><div><b id="sideName">Business Owner</b><small id="sideEmail">Signed in</small></div></div>
</div>
</aside>

<main class="main">
<header class="top">
<div class="business"><span class="muted">Business</span><strong id="businessTop">Acme Auto Care ▾</strong></div>
<div class="topright">
<span id="topEmail" class="top-email"></span>
<button class="ghost" type="button" onclick="signOut()">Sign out</button>
<button class="ghost" type="button" onclick="showToast('Help center is coming soon.')">?</button>
<div class="bell-wrap">
<button id="bellButton" class="ghost bell-button" type="button" onclick="toggleNotifications()" aria-label="Notifications">
<span class="bell-icon">♢</span>
<span id="notificationBadge" class="notification-badge hidden">0</span>
</button>
<div id="notificationPanel" class="notification-panel hidden">
<div class="notification-head"><b>Notifications</b><button class="notification-clear" type="button" onclick="markNotificationsRead()">Mark read</button></div>
<div id="notificationItems"></div>
<div class="notification-foot"><button type="button" onclick="openActivityFromBell()">View all activity</button></div>
</div>
</div>
<div id="topAvatar" class="avatar">U</div>
</div>
</header>

<section id="dashboard" class="page">
<div class="head">
<div><div class="eyebrow">REVIEW HEALTH</div><h1 id="welcomeTitle">Good evening 👋</h1><div class="muted">Monitor, analyze and organize your business reviews.</div></div>
<button class="primary" type="button" onclick="show('analyzer',document.querySelectorAll('.nav button')[2])">＋ Analyze review</button>
</div>
<div class="stats">
<div class="card stat"><small>Average rating</small><strong id="avgRating">0.0 ★</strong><span class="green">Live data</span></div>
<div class="card stat"><small>Total reviews</small><strong id="totalReviews">0</strong><span class="green">Your account</span></div>
<div class="card stat"><small>Potential issues</small><strong id="flagCount">0</strong><span class="amber">Needs attention</span></div>
<div class="card stat"><small>Open cases</small><strong id="caseCount">0</strong><span class="muted">Your account</span></div>
</div>
<div class="grid2">
<div class="card section"><h2>Rating overview</h2><div class="chart-wrap"><canvas id="ratingChart"></canvas></div></div>
<div class="card section"><h2>Review health</h2><div class="chart-wrap"><canvas id="healthChart"></canvas></div></div>
</div>
<div class="card section"><h2>What ReviewShield does</h2><p class="muted">Analyze reviews for potential policy issues, organize evidence, prepare reporting information, and generate professional responses. Google makes the final decision on policy violations.</p></div>
<div class="card section"><h2>Recent reviews</h2><div id="dashReviews" class="review-list"></div></div>
</section>

<section id="reviews" class="page hidden">
<div class="head"><div><div class="eyebrow">REVIEWS</div><h1>Review inbox</h1><div class="muted">Reviews saved to your account.</div></div><button class="primary" type="button" onclick="show('analyzer',document.querySelectorAll('.nav button')[2])">Analyze a review</button></div>
<div class="card section">
<div class="toolbar" id="reviewFilters">
<button class="filter-btn active" onclick="setReviewFilter('all',this)">All</button>
<button class="filter-btn" onclick="setReviewFilter('5',this)">5★</button>
<button class="filter-btn" onclick="setReviewFilter('4',this)">4★</button>
<button class="filter-btn" onclick="setReviewFilter('3',this)">3★</button>
<button class="filter-btn" onclick="setReviewFilter('2',this)">2★</button>
<button class="filter-btn" onclick="setReviewFilter('1',this)">1★</button>
<button class="filter-btn" onclick="setReviewFilter('issues',this)">Potential Issues</button>
</div>
<div id="allReviews" class="review-list"></div>
</div>
</section>

<section id="analyzer" class="page hidden">
<div class="head"><div><div class="eyebrow">AI REVIEW ANALYZER</div><h1>Analyze a review</h1><div class="muted">Transparent rule-based analysis with results saved privately to your account.</div></div></div>
<div class="card section"><div class="form">
<label><b>Review text</b></label>
<textarea id="reviewText" placeholder="Paste a review here..."></textarea>
<button class="primary" type="button" onclick="analyze()">Analyze review</button>
<div id="analysisResult"></div>
</div></div>
</section>

<section id="cases" class="page hidden">
<div class="head"><div><div class="eyebrow">CASE MANAGEMENT</div><h1>Cases</h1><div class="muted">Track reviews that need evidence or reporting.</div></div></div>
<div class="card section">
<div class="toolbar"><button class="filter-btn active" type="button" onclick="filterCases('all',this)">All</button><button class="filter-btn" type="button" onclick="filterCases('open',this)">Open</button><button class="filter-btn" type="button" onclick="filterCases('closed',this)">Closed</button></div>
<div id="caseList"></div>
</div>
</section>

<section id="responses" class="page hidden">
<div class="head"><div><div class="eyebrow">AI RESPONSES</div><h1>Response assistant</h1><div class="muted">Generate a professional draft for a legitimate negative review.</div></div></div>
<div class="card section"><div class="form">
<label><b>Customer review</b></label>
<textarea id="responseText" placeholder="Paste the customer's review..."></textarea>
<label><b>Tone</b></label>
<select id="responseTone"><option value="professional">Professional</option><option value="warm">Warm &amp; Empathetic</option><option value="short">Short &amp; Concise</option><option value="factual">Professional &amp; Factual</option></select>
<button class="primary" type="button" onclick="generateResponse()">Generate draft</button>
<div id="responseResult"></div>
</div></div>
</section>

<section id="profile" class="page hidden">
<div class="head"><div><div class="eyebrow">PROFILE</div><h1>Account &amp; business profile</h1><div class="muted">Keep your account and business information ready for review workflows.</div></div></div>
<div class="grid2">
<div class="card section">
<h2>Your profile</h2>
<div id="profileAvatar" class="profile-avatar">U</div>
<div class="form">
<div class="field"><label>Full name</label><input id="profileName" placeholder="Your name"></div>
<div class="field"><label>Email</label><input id="profileEmail" disabled></div>
<button class="primary" type="button" onclick="saveProfile()">Save profile</button>
</div>
</div>
<div class="card section">
<h2>Business details</h2>
<div class="form">
<div class="field"><label>Business name</label><input id="businessName" placeholder="Business name"></div>
<div class="field"><label>Category</label><input id="businessCategory" placeholder="e.g. Auto Repair"></div>
<div class="field"><label>Website</label><input id="businessWebsite" placeholder="https://example.com"></div>
<div class="field"><label>Location</label><input id="businessLocation" placeholder="City, State, Country"></div>
<button class="primary" type="button" onclick="saveBusiness()">Save business</button>
</div>
</div>
</div>
</section>

<section id="activity" class="page hidden">
<div class="head"><div><div class="eyebrow">ACTIVITY</div><h1>Notifications &amp; activity</h1><div class="muted">Recent activity from this ReviewShield session.</div></div></div>
<div class="card section"><div id="activityList"></div></div>
</section>

<section id="settings" class="page hidden">
<div class="head"><div><div class="eyebrow">SETTINGS</div><h1>Settings</h1><div class="muted">Account, data and Google integration settings.</div></div></div>
<div class="card section">
<h2>Account</h2><p class="muted">Signed in as <b id="settingsEmail"></b></p>
<div class="toolbar"><button class="ghost" type="button" onclick="signOut()">Sign out</button><button class="ghost" type="button" onclick="exportReport()">Export report</button></div>
</div>
<div class="card section">
<h2>Google Business Profile</h2>
<p class="muted">Status: <b id="googleStatus">Not connected</b></p>
<button class="primary" type="button" onclick="connectGoogle()">Connect Google</button>
<p class="muted" style="font-size:12px;margin-top:10px">This is a real connection placeholder. No fake Google account connection is claimed until OAuth/API access is configured.</p>
</div>
</section>

</main></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const SUPABASE_URL="https://ppqavvwcmgojbddnqwpl.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="sb_publishable_Q6IJEnT3XvDI8KXMWpatkg_bNyxpKie";
const supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);

let reviews=[];
let cases=[];
let currentUser=null;
let signupMode=false;
let reviewFilter="all";
let caseFilter="all";
let ratingChart=null;
let healthChart=null;
let activity=[];
let profileData={};

function $(id){return document.getElementById(id)}
function escapeHTML(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}

function showToast(message){
  const msg=$('authMsg');
  if(msg && $('authWrap').classList.contains('hidden')) {
    activity.unshift({text:message,date:new Date().toISOString()});
    renderActivity();
  } else if(msg) msg.innerHTML='<span class="green">'+escapeHTML(message)+'</span>';
}

function toggleAuthMode(){
  signupMode=!signupMode;
  $('authTitle').textContent=signupMode?'Create your ReviewShield account':'Welcome to ReviewShield AI';
  $('authSubtitle').textContent=signupMode?'Create an account to keep your dashboard and data private.':'Sign in to access your private review dashboard.';
  $('authButton').textContent=signupMode?'Create account':'Sign in';
  $('authSwitchText').textContent=signupMode?'Already have an account?':"Don't have an account?";
  document.querySelector('.auth-switch button').textContent=signupMode?'Sign in':'Create account';
  $('signupNameWrap').classList.toggle('hidden',!signupMode);
  $('authMsg').textContent='';
  $('authPassword').autocomplete=signupMode?'new-password':'current-password';
}

async function handleAuth(){
  const button=$('authButton'),msg=$('authMsg');
  const email=$('authEmail').value.trim().toLowerCase();
  const password=$('authPassword').value;
  const name=($('authName')?.value||'').trim()||'Business Owner';
  msg.textContent='';
  if(!email||!password){msg.innerHTML='<span class="amber">Enter your email and password.</span>';return}
  if(password.length<6){msg.innerHTML='<span class="amber">Password must be at least 6 characters.</span>';return}
  button.disabled=true;button.textContent=signupMode?'Creating account…':'Signing in…';
  try{
    let result;
    if(signupMode){
      result=await supabaseClient.auth.signUp({email,password,options:{data:{full_name:name}}});
      if(result.error) throw result.error;
      if(!result.data.session){
        msg.innerHTML='<span class="green"><b>Account created ✓</b><br>Check your email for the confirmation link, then sign in.</span>';
        return;
      }
    }else{
      result=await supabaseClient.auth.signInWithPassword({email,password});
      if(result.error) throw result.error;
    }
    if(!result.data?.user||!result.data?.session){
      msg.innerHTML='<span class="amber">No active session was returned. If email confirmation is enabled, confirm your email first.</span>';
      return;
    }
    await startApp(result.data.user);
  }catch(err){
    console.error('Authentication error:',err);
    msg.innerHTML='<span class="danger">'+escapeHTML(err?.message||'Unable to sign in. Please try again.')+'</span>';
  }finally{
    button.disabled=false;
    button.textContent=signupMode?'Create account':'Sign in';
  }
}

async function startApp(user){
  currentUser=user;
  $('authWrap').classList.add('hidden');
  $('appShell').classList.remove('hidden');
  const email=user.email||'';
  const meta=user.user_metadata||{};
  const name=meta.full_name||email.split('@')[0]||'Business Owner';
  const initial=(name.charAt(0)||email.charAt(0)||'U').toUpperCase();
  $('topAvatar').textContent=initial;$('sideAvatar').textContent=initial;$('profileAvatar').textContent=initial;
  $('topEmail').textContent=email;$('sideName').textContent=name;$('sideEmail').textContent=email;$('settingsEmail').textContent=email;
  $('profileName').value=name;$('profileEmail').value=email;
  $('welcomeTitle').textContent='Good evening, '+name+' 👋';
  loadLocalProfile();
  try{await loadData()}catch(err){
    console.error(err);
    $('dashReviews').innerHTML='<div class="result">Could not load your private data.<br><br>'+escapeHTML(err.message||err)+'</div>';
    render();
  }
}

async function signOut(){
  try{await supabaseClient.auth.signOut()}catch(err){console.error(err)}
  currentUser=null;reviews=[];cases=[];
  destroyCharts();
  $('appShell').classList.add('hidden');
  $('authWrap').classList.remove('hidden');
  $('authMsg').innerHTML='<span class="green">Signed out successfully.</span>';
}

function normalizeReview(r){
  const text=r.text??r.review_text??'';
  const name=r.name??r.reviewer_name??'Reviewer';
  const assessment=r.assessment||(r.issue_type?'Potential issue':'Likely legitimate');
  const rating=Number(r.rating||0);
  return {...r,text,name,assessment,rating,cls:/Potential|Needs|issue/i.test(assessment)?'flag':'safe'};
}
function normalizeCase(c){return {...c,name:c.name||c.review_name||'Review case',issue:c.issue||c.issue_type||c.evidence_notes||'Review requires attention',status:c.status||'Open',priority:c.priority||'medium',evidence_notes:c.evidence_notes||''}}

async function loadData(showStatus=false){
  if(!currentUser)return;
  if(showStatus)$('dashReviews').innerHTML='<div class="result">Refreshing your live Supabase data…</div>';
  const [reviewsRes,casesRes]=await Promise.all([
    supabaseClient.from('reviews').select('*').eq('user_id',currentUser.id).order('created_at',{ascending:true}),
    supabaseClient.from('cases').select('*').eq('user_id',currentUser.id).order('created_at',{ascending:true})
  ]);
  if(reviewsRes.error)throw reviewsRes.error;
  if(casesRes.error)throw casesRes.error;
  reviews=(reviewsRes.data||[]).map(normalizeReview);
  cases=(casesRes.data||[]).map(normalizeCase);
  updateStats();render();renderCharts();
}

function updateStats(){
  const avg=reviews.length?(reviews.reduce((a,r)=>a+Number(r.rating||0),0)/reviews.length).toFixed(1):'0.0';
  const flags=reviews.filter(r=>r.issue_type||/Potential|Needs|issue/i.test(r.assessment||'')).length;
  const open=cases.filter(c=>!/resolved|closed/i.test(c.status||'')).length;
  $('avgRating').textContent=avg+' ★';$('totalReviews').textContent=reviews.length;$('flagCount').textContent=flags;$('caseCount').textContent=open;
}

function reviewHTML(r){
  const id=JSON.stringify(String(r.id));
  const stars='★'.repeat(Math.max(0,Math.min(5,r.rating)))+'☆'.repeat(Math.max(0,5-r.rating));
  return `<div class="review"><div><b>${escapeHTML(r.name)}</b> &nbsp; <span class="badge ${r.cls}">${escapeHTML(r.assessment||'Likely legitimate')}</span><small> · ${stars}</small><p>“${escapeHTML(r.text)}”</p><small>${escapeHTML(r.reviewer_name||'Reviewer')} · ${new Date(r.created_at||Date.now()).toLocaleString()}</small></div><div class="actions"><button class="ghost" type="button" onclick='loadReview(${id})'>Analyze</button></div></div>`;
}

function render(){
  $('dashReviews').innerHTML=reviews.length?reviews.slice(-3).reverse().map(reviewHTML).join(''):'<div class="empty">No reviews yet. Analyze your first review.</div>';
  let filtered=reviews.slice().reverse();
  if(reviewFilter!=='all'){
    if(reviewFilter==='issues')filtered=filtered.filter(r=>r.issue_type||/Potential|Needs|issue/i.test(r.assessment||''));
    else filtered=filtered.filter(r=>Number(r.rating)===Number(reviewFilter));
  }
  $('allReviews').innerHTML=filtered.length?filtered.map(reviewHTML).join(''):'<div class="empty">No reviews match this filter.</div>';
  renderCases();
}

function setReviewFilter(filter,btn){
  reviewFilter=filter;
  document.querySelectorAll('#reviewFilters .filter-btn').forEach(x=>x.classList.remove('active'));
  btn.classList.add('active');render();
}

function renderCases(){
  let list=cases.slice().reverse();
  if(caseFilter==='open')list=list.filter(c=>!/resolved|closed/i.test(c.status||''));
  if(caseFilter==='closed')list=list.filter(c=>/resolved|closed/i.test(c.status||''));
  $('caseList').innerHTML=list.length?list.map(c=>`
    <div class="case">
      <div><b>${escapeHTML(c.name)}</b><div class="muted">${escapeHTML(c.issue)}</div><small class="muted">Priority: ${escapeHTML(c.priority)}</small></div>
      <span class="status">${escapeHTML(c.status)}</span>
      <div class="actions"><button class="ghost" type="button" onclick='editCase(${JSON.stringify(String(c.id))})'>Manage</button></div>
    </div>`).join(''):'<div class="empty">No cases yet.</div>';
}
function filterCases(filter,btn){
  caseFilter=filter;
  document.querySelectorAll('#cases .filter-btn').forEach(x=>x.classList.remove('active'));
  btn.classList.add('active');renderCases();
}

async function editCase(id){
  const c=cases.find(x=>String(x.id)===String(id));if(!c)return;
  const status=prompt('Case status (Open / Needs evidence / Closed):',c.status||'Open');if(status===null)return;
  const priority=prompt('Priority (low / medium / high):',c.priority||'medium');if(priority===null)return;
  const evidence=prompt('Evidence notes:',c.evidence_notes||'');if(evidence===null)return;
  const {data,error}=await supabaseClient.from('cases').update({status,priority,evidence_notes:evidence}).eq('id',c.id).eq('user_id',currentUser.id).select().single();
  if(error){showToast('Case update failed: '+error.message);return}
  const idx=cases.findIndex(x=>String(x.id)===String(c.id));if(idx>=0)cases[idx]=normalizeCase(data);
  updateStats();render();addActivity('Case updated');showToast('Case updated successfully.');
}

function loadReview(id){
  const r=reviews.find(x=>String(x.id)===String(id));if(!r)return;
  show('analyzer',document.querySelectorAll('.nav button')[2]);
  $('reviewText').value=r.text;analyze(false);
}

async function analyze(saveToDatabase=true){
  const t=$('reviewText').value.trim();
  if(!t){$('analysisResult').innerHTML='<div class="result">Please paste a review first.</div>';return}
  let signals=[];
  if(/never (went|visited)|never been|didn.?t visit/i.test(t))signals.push('Reviewer states or suggests they did not visit the business.');
  if(/scam|fraud|worst|idiot|stupid|hate|trash/i.test(t))signals.push('Contains potentially abusive or accusatory language.');
  if(/https?:\/\/|www\.|promo|discount code|buy now/i.test(t))signals.push('Possible promotional or link content detected.');
  const high=signals.length>0;
  $('analysisResult').innerHTML=`<div class="result"><strong>${high?'Potential policy issue — review required':'No obvious policy signal detected'}</strong><div class="muted">${signals.join('<br>')||'Review appears clear of structural automated policy flags.'}</div></div>`;
}
</script>
</body>
</html>
